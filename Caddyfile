{
	# Railway's edge terminates TLS and injects $PORT, so Caddy runs plain HTTP
	# and does not need its own certificate management or admin API.
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		# Trust Railway's edge/proxy so {remote_host}, X-Forwarded-For and
		# X-Forwarded-Proto reflect the real client instead of the proxy.
		trusted_proxies static private_ranges 100.64.0.0/10
	}
}

:{$PORT:8080} {
	log {
		format json
	}

	# Railway healthcheck target (see healthcheckPath in railway.toml).
	respond /health 200

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Reverse proxy for the API. Point API_URL at the backend's Railway private
	# domain, e.g. http://backend.railway.internal:8080 — private networking is
	# IPv6-only, so always include the scheme and port.
	# While API_URL is unset this block answers 502, it does not break startup.
	handle /api/* {
		reverse_proxy {$API_URL:http://127.0.0.1:9} {
			header_up X-Forwarded-Host {host}
		}
	}

	# Static SPA: hashed assets are immutable, the HTML shell never is.
	handle {
		root * dist

		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
